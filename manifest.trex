<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.smartrisk.hackathon" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name">SmartRisk Analytics</name>
    <description>AI-powered portfolio risk management</description>
    <author name="Your Name" email="your@email.com" organization="Hackathon" website="https://github.com"/>
    <min-api-version>1.4</min-api-version>
    <source-location>
      <!-- <url>https://double-cold-water.github.io/smartrisk-extension/smartrisk-extension.html</url> -->
      <url>https://double-cold-water.github.io/smartrisk-extension/debug.html</url>
    </source-location>
    <icon>iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==</icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
  </dashboard-extension>
</manifest>
